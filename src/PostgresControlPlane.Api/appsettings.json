{
  "ConnectionStrings": {
    "MainDatabase": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "PostgresControlPlane",
    "Audience": "PostgresControlPlane.Client",
    "AccessTokenLifetimeMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "KnownProxies": []
  },
  "Hosting": {
    "PathBase": "/server"
  },
  "Storage": {
    "RootPath": "data/uploads",
    "MaxFileSizeBytes": 10485760
  },
  "Audit": {
    "RetentionDays": 90,
    "CleanupIntervalHours": 24
  },
  "Kubernetes": {
    "Enabled": false,
    "Namespace": "postgres-control",
    "WorkloadImage": "postgres-control-plane:1.0.0",
    "PublicBaseUrl": "",
    "IngressTlsSecretName": ""
  },
  "DatabaseInitialization": {
    "ApplyMigrations": false
  },
  "DatabaseBrowser": {
    "CommandTimeoutSeconds": 5,
    "MaxPageSize": 200,
    "MaxTextLength": 4096,
    "MaxResponseBytes": 1048576,
    "RoutineExecutionEnabled": true,
    "AllowedRoutineSchemas": [
      "public"
    ],
    "AllowProcedures": true,
    "AllowSecurityDefiner": false,
    "RoutineCommandTimeoutSeconds": 10,
    "MaxRoutineArguments": 32,
    "MaxRoutineArgumentLength": 16384,
    "MaxRoutineRows": 200,
    "RoutineExcelExportEnabled": true,
    "MaxExcelRows": 10000,
    "MaxExcelColumns": 256,
    "MaxExcelCells": 200000,
    "MaxExcelFileSizeBytes": 10485760
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "Username": "",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
