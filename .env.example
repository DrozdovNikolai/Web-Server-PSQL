# Copy this file to .env for local development. Never reuse these values outside localhost.
POSTGRES_PASSWORD=local-postgres-password-change-me
JWT_SIGNING_KEY=local-only-signing-key-change-me-32-chars-minimum
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=local-admin-password-change-me

# Direct `dotnet run` equivalents.
ConnectionStrings__MainDatabase=Host=localhost;Port=5432;Database=postgres_control;Username=postgres_control;Password=local-postgres-password-change-me
Jwt__SigningKey=local-only-signing-key-change-me-32-chars-minimum
Jwt__Issuer=PostgresControlPlane
Jwt__Audience=PostgresControlPlane.Client
Jwt__AccessTokenLifetimeMinutes=15
Cors__AllowedOrigins__0=http://localhost:5173
# Add only the actual reverse proxy IP in hosted environments.
# Proxy__KnownProxies__0=10.0.0.10
Hosting__PathBase=/server
Storage__RootPath=data/uploads
Storage__MaxFileSizeBytes=10485760
Audit__RetentionDays=90
Audit__CleanupIntervalHours=24
Kubernetes__Enabled=false
Kubernetes__Namespace=postgres-control
Kubernetes__WorkloadImage=postgres-control-plane:0.1.0
Kubernetes__PublicBaseUrl=
Kubernetes__IngressTlsSecretName=
DatabaseInitialization__ApplyMigrations=true
DatabaseBrowser__CommandTimeoutSeconds=5
DatabaseBrowser__MaxPageSize=200
DatabaseBrowser__MaxTextLength=4096
DatabaseBrowser__MaxResponseBytes=1048576
DatabaseBrowser__RoutineExecutionEnabled=true
DatabaseBrowser__AllowedRoutineSchemas__0=public
DatabaseBrowser__AllowProcedures=true
DatabaseBrowser__AllowSecurityDefiner=false
DatabaseBrowser__RoutineCommandTimeoutSeconds=10
DatabaseBrowser__MaxRoutineArguments=32
DatabaseBrowser__MaxRoutineArgumentLength=16384
DatabaseBrowser__MaxRoutineRows=200
DatabaseBrowser__RoutineExcelExportEnabled=true
DatabaseBrowser__MaxExcelRows=10000
DatabaseBrowser__MaxExcelColumns=256
DatabaseBrowser__MaxExcelCells=200000
DatabaseBrowser__MaxExcelFileSizeBytes=10485760
BootstrapAdmin__Enabled=true
BootstrapAdmin__Username=admin
BootstrapAdmin__Password=local-admin-password-change-me
